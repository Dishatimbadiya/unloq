# Unloq Policy Assistant Configuration
# Copy this to .env and update with your values

# ============= DATABASE =============
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unloq
PGVECTOR_DIM=1024

# ============= EMBEDDINGS =============
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ============= RETRIEVAL =============
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5
USE_BM25_FALLBACK=true

# ============= RE-RANKER =============
RERANKER_MODEL=cross-encoder/msl-mcd6
RERANKER_TOP_K=3

# ============= LLM =============
LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o

# ============= LOGGING =============
LOG_LEVEL=INFO
